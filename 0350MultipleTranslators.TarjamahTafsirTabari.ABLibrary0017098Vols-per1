# 56 - مىشتابانيم ايشان را اندر نيكيها ؟ نه كه نه دانند 
# 57 - حقا كه آن كسها كه ايشانند از بيم خداوندشان [ ترسندگانند ]
# 58 - و آن كسها كه ايشانند [ بنشانيهاى ] خداوندشان گرويدگانند « 6
~~»
# 59 - و آن كسها كه ايشان بخداوندشان نه انباز گيرانند 
# 60 - و آن كسها كه بدهند آنچه بدادند و دلهاشان [ ترسان است ] سوى
~~خداوندشان باز آمدند 
# 61 - ايشانند كه مىشتابند اندر نيكيها ، [ و ايشان مر ] آن را
~~پيشى كنندگانند 
# 62 - و نه نهيم بر تنى مگر آنچه تواناى اوست ، و نزديك ما كتابى سخن
~~مىگويد براستى ، و ايشان نه ستم كاران‌اند 
# 63 - نه كه دلهاشان اندر پوششى است از اين ، و ايشان را كردارهاست 
~~از بيرون آن ايشانند آن را كار كنندگان‌اند
PageV05P016
# 64 - تا آن گاه كه بگرفتيم خداوند نعمت ايشان را به عذاب آن گاه
~~ايشان زارى همى كنند
# 65 - مه زارى كنيد امروز كه شما از ما نه يارى كنندتان 
# 66 - بدرستى كه بود آيتهاى ما كه مىخواندند بر شما و بوديد بر
~~پاشنه‌هاتان همى بازگشتيدى 
# 67 - تكبر همى كرديد بدان و رسمى همى نهاديد و فحش همى گفتيد 
# 68 - همى نه انديشه كنند گفتار خويش يا آمدشان آنچه نه آمد پدران‌شان
~~پيشينگان ؟ 
# 69 - يا نه شناختند پيغامبران‌شان و هستند ايشان او را ناشناختگان ؟ « 7
~~»
# 70 - يا مىگويند بدوست ديوانگى ؟ نه كه آمد بديشان براستى و بيشتر ايشان
~~ راستى را دشخوار دارند
# 71 - و اگر متابعت كند حق بهواهاى ايشان تباه گردد آسمانها و زمين
~~و آنك اندران باشند . نه كه بداديم ايشان را ياد كار ايشان و ايشانند از
~~ياد كرد ايشان بر گردندگان 
PageV05P017
# 72 - همى خواهى از ايشان چيزى بيرون كردن [ از خواسته مزد ] ؟ 
~~خداوند تو بهتر ، و اوست بهتر روزى دهندگان
# 73 - و كه تو مىخوانى ايشان را بسوى راه راست
# 74 - و حقا كه آن كسها كه نه گروند برستاخيز از راه راست [ بتابند ] « 2
~~»
# 75 - و اگر رحمت كنيم بر ايشان و باز [ بگشاديمى آنچه ] به ايشانست
~~از سختى اندر روند اندر بيراهىشان مىگردند 
# 76 - و بدرستى كه بگرفتيم [ شان ] به عذاب ، و نه گردن نهادند [ مر
~~خداوند خويش را ] و نه زارى كنند 
# 77 - تا چون بگشاديم بر ايشان درى خداوند عذابى سخت آن گاه ايشان
~~اندران باشند نوميدان 
# 78 - و اوست خداى آنك بيافريد شما را گوشها و چشمها و دلها و اندكىاند
~~آنك شكر همىكنند 
# 79 - و اوست آنك بيافريد شما را اندر زمين و سوى او بر انگيزند شما را 
PageV05P018
# 80 - و اوست آنك زنده كند و بميراند و او راست شدن و آمدن شب و روز همى
~~نه اندر يابند
# 81 - نه كه گفتند هم چنان كه گفتند پيشينگان 
# 82 - گفتند : چون بميريم و باشيم خاكى و استخانى ما باشيم بر انگيختگان ؟
~~ 
# 83 - بدرستى وعده كردند ما را و پدران ما را اين از پيش ، كه نيست اين
~~مگر افسانهاى پيشينگان 
# 84 - بگوى كه : كراست زمين و آنك اندران اگر هستيد و ميدانيد ؟
# 85 - تا گويند : خداى راست . بگوى : چرا مىنه پند پذيريد ؟ 
# 86 - بگوى : كيست خداوند آسمانهاى هفت گانه و خداوند عرش بزرگوار 
# 87 - تا گويند : خداى . بگوى : چرا همى نپرهيزيد ؟ 
# 88 - بگوى : كيست آنك بدست اوست پادشاهى همه چيزى ، و اوست كه
~~فرياد رسد و نه فرياد رسند بر او اگر هستيد و مىدانيد ؟
PageV05P019
# 89 - تا گويند : خدايست . بگوى : چه گونه پوشانند بر شما ؟ 
# 90 - نه كه بداديم ايشان را حق و ايشانند دروغ زنان
# 91 - نه گرفت خداى عز و جل هيچ فرزندى ، و نه بود با او هيچ خداى ، آن
~~گاه بشود هر خداى بدانچه آفريد است ، و بر شود كسى از ايشان بر كسى . « 4
~~» پاك است خداى عز و جل از آنچه مىصفت كنند كافران
# 92 - داناى پنهانست و آشكارا و بر دورست از آنچه انباز گيرند
# 93 - بگو : يا خداوند من اگر بنمايى مرا آنچه وعده كردست 
# 94 - خداوند من مكن مرا اندر گروه ستم كاران
# 95 - و ماييم بران كه بنماييم ترا بر آنچه همى وعده كنيم ايشان را توانا
# 96 - بازدار بآنك آن نيكوتر زشتى را كه ماييم داناتر بدانچه مىصفت
~~كنند
# 97 - و بگو : خداوند من پناه مىگيرم به تو از وسوسهاى ديوان
# 98 - بازداشت همى خواهم به تو يا خداوند من كه حاضر آيند بنزديك من 
# 99 - تا آن گاه كه بيايد يكى از ايشان مرگ گفت : يا خداوند
PageV05P020
# من باز گردانيد مرا
# 100 - تا من كار كنم نيكو اندر آنچه دست باز داشتم . نباشد اين كه اين
~~سخنى است او گوينده آنست ، و از بر ايشان حجابى [ است ] تا آن روز كه بر
~~انگيزندشان 
# 101 - آن گه كه بدمند اندر صور نه باشد نسبها ميان ايشان آن روز و
~~نه پرسند يك ديگر [ را ]
# 102 - هر كى را گران ترازو وى از نيكى ايشانند ايشان رستگاران
# 103 - و هر كى سبك آيد ترازو او ايشانند آن كسها كه زيان كردند تنهاى
~~خويش را و در دوزخ باشند جاودان
# 104 - و اندر مىدمد اندر رويهاشان آتش و ايشان باشند اندر آنجا ترش رويان
~~و سياه رويان 
# 105 - همى نديدى كه آيتهاى من همى خواندند بر شما و بوديد شما و آن
~~را بدروغ همى داشتيد
# 106 - گفتند : يا خداوند ما غلبت كرد بر ما بدبختى ما و بوديم ما
~~گروهى گمراهان
# 107 - يا خداوند ما بيرون آر ما را از آن اگر باز گرديم و ديگر
~~كنيم باشيم ما ستم كاران
PageV05P021
# 108 - گويد : دور باشيد اندران و مه سخن گوييد مرا
# 109 - كه بودند گروهى از بندگان من گفتند : يا خداوند ما بگرويديم ما
~~بيامرز ما را و ببخشاى ما را كه تو اى بهترين بخشايندگان
# 110 - گرفتيد ايشان را افسوس تا فراموش كردند شما را ياد كرد من ، و
~~بوديد شما از ايشان مىخنديد 
# 111 - كه من پاداش كنم ايشان را امروز بدانچه شكيبايى كردند كه
~~ايشانند ايشان رستگاران
# 112 - گفت : چند بمانديد اندر زمين بشمار سال 
# 113 - گفتند : بوديم روزى يا برخى روزى بپرس از شمار گيران
# 114 - گفت : نه بوديد مگر اندكى اگر شما بوديد و ميدانستيد
# 115 - مىپنداريد شما كه ما بيافريديم شما را ببازى و شما را سوى ما
~~نه باز گردانند ؟
# 116 - بر دورست خداى عز و جل پادشاه راست ، نيست خداى مگر او
~~خداوند عرش بزرگوار
